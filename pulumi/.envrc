if ! has nix_direnv_version || ! nix_direnv_version 3.0.7; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.7/direnvrc" "sha256-bn8WANE5a91RusFmRI7kS751ApelG02nMcwRekC/qzc="
fi

use flake ..
layout node

mkdir -p ./state

# Encrypt local Pulumi state in ./state using the secret from sops so it is safe to commit to git:
export PULUMI_CONFIG_PASSPHRASE="$(sops -d --extract '["pulumi_config_passphrase"]' ../secrets/secrets.yaml)"

# Use an isolated gcloud config directory so personal GCP ADC never overwrites work (robin@skunk.team) credentials:
export CLOUDSDK_CONFIG="$HOME/.config/gcloud-personal"
export GOOGLE_APPLICATION_CREDENTIALS="$CLOUDSDK_CONFIG/application_default_credentials.json"
